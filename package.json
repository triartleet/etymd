{
  "name": "clothaid",
  "version": "0.0.1",
  "description": "Agent-agnostic agentic-workflow CLI — reckon a project and install, migrate, or optimise a disciplined AI-agent workflow, then keep it honest.",
  "keywords": [
    "cli",
    "ai",
    "agents",
    "agentic",
    "workflow",
    "claude",
    "cursor",
    "copilot",
    "developer-tools",
    "scaffolding"
  ],
  "license": "MIT",
  "author": "Alkis Yuv",
  "type": "module",
  "bin": {
    "clothaid": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@clack/prompts": "0.7.0",
    "commander": "12.1.0",
    "picocolors": "1.1.1",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
