{
  // Markdown validation rules — deliberately PER PROJECT rather than in VS Code's user
  // settings, so that no other repo inherits them. The user-level block owns only preview
  // cosmetics (stylesheet, font, line height, wrap); the rules that produce warnings live here.
  //
  // These settings are ADVISORY, never a second opinion on a push gate. Link checking is not
  // wired here — a dedicated checker was tried and reverted as disproportionate — so the
  // editor is the only surface reporting these, and it has never been in the push path.
  //
  // referenceLinks is OFF because it does not survive measurement: it produced 301 of 326
  // warnings with zero true positives, all ordinary bracketed prose ([CRITICAL], [bot],
  // [--base <branch>]), burying real findings beneath them. A real CommonMark parser has no
  // such rule — an undefined shortcut reference is a text node, not a link.
  "markdown.validate.referenceLinks.enabled": "ignore",

  // These two stay on: between them they found every real defect — links left behind by a
  // file move, a doubled path prefix, and a fragment pointing at a renumbered heading.
  "markdown.validate.fileLinks.enabled": "warning",
  "markdown.validate.fragmentLinks.enabled": "warning",

  // The preview stylesheet MUST be workspace-relative: VS Code resolves markdown.styles
  // against the folder open in the Explorer and will not reliably load an absolute local
  // path, so a user-settings copy does nothing. This file is a verbatim copy of the
  // machine-local source. It also makes code blocks SCROLL rather than wrap — wrapping
  // breaks ASCII diagrams and misrepresents indentation. Removing it breaks the preview.
  "markdown.styles": [".vscode/markdown-preview.css"]
}
